# Copy this file to .env and fill in the values you need. Every variable is
# optional: the app runs out of the box with none of them set.

# --- Deployment path -------------------------------------------------------
# Where the app is served from. Leave unset (or "/") for a root or subdomain
# deploy (e.g. platform.apacss.com). Set a subpath to host it under a folder of
# the main site, e.g. "/platform/" for apacss.com/platform. See INTEGRATION.md.
# VITE_BASE_PATH=/platform/

# --- AI assistant (OpenRouter) ---------------------------------------------
# Powers the CDMO assistant's free-text understanding. The assistant's core
# flows are deterministic and work with NO key; a key only adds natural
# phrasing. WARNING: a build-time VITE_ key is bundled into the browser and is
# readable by anyone who loads the app. For production, proxy OpenRouter through
# a small backend instead, or let each user enter their own key in the UI.
# See SECURITY.md.
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_MODEL=openrouter/auto

# --- Admin gate ------------------------------------------------------------
# The admin area (usage analytics + the internal synthesis explorer) is gated by
# a client-side password. This keeps internal tooling out of casual view; it is
# NOT a security boundary (see SECURITY.md). Set this to the SHA-256 hex of your
# password to change it from the default ("apac-admin"). Generate with:
#   echo -n "yourpassword" | shasum -a 256
VITE_ADMIN_PASSWORD_HASH=
