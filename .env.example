# Copy this file to .env and fill in the values you need. Every variable is
# optional: the app runs out of the box with none of them set.

# --- Deployment path -------------------------------------------------------
# Where the app is served from. Leave unset (or "/") for a root or subdomain
# deploy (e.g. platform.apacss.com). Set a subpath to host it under a folder of
# the main site, e.g. "/platform/" for apacss.com/platform. See INTEGRATION.md.
# VITE_BASE_PATH=/platform/

# --- AI assistant (OpenRouter) ---------------------------------------------
# Powers the CDMO assistant's free-text understanding and the online synthesis-
# route / product research. The core flows are deterministic and work with NO
# key; a key adds natural phrasing and the online chemistry lookup.
#
# RECOMMENDED: the keyless proxy (see below). Do NOT put a real key in a VITE_
# variable for production, a build-time VITE_ key is bundled into the browser and
# is readable by anyone who loads the app. See SECURITY.md and DEPLOYMENT.md.
#
# Option A, keyless proxy (recommended). The key lives ONLY in the server env as
# OPENROUTER_API_KEY (no VITE_ prefix), and the browser talks to /api/ai. Set:
#   VITE_AI_PROXY_URL=/api/ai
#   OPENROUTER_API_KEY=sk-or-...            (set in your HOST's env, not committed)
# The web-search chemistry lookup needs OpenRouter credit; with $0 credit it
# still works but falls back to a free model answering from its own knowledge
# (labelled "AI-researched, verify"). Add a few dollars of credit at
# https://openrouter.ai/settings/credits to enable true web-grounded results.
#
# Option B, per-user key. Leave the proxy unset; each user pastes their own key
# in the UI, or you accept the exposure of a bundled VITE_ key below.
VITE_AI_PROXY_URL=
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_MODEL=openrouter/free
# Model used for web-grounded research calls (needs credit; falls back to free).
VITE_OPENROUTER_WEB_MODEL=openai/gpt-4o-mini

# Server-side key for the keyless proxy. Set this in your HOST's environment
# variables (Vercel/Netlify/Cloudflare/etc.), NEVER commit it, NEVER add a VITE_
# prefix. Used by api/ai.ts and the Vite dev/preview proxy.
# OPENROUTER_API_KEY=sk-or-...

# --- Web search for chemistry (SearXNG, no credit) -------------------------
# Real web grounding for the synthesis-route lookup WITHOUT any OpenRouter credit:
# the app searches a SearXNG instance (free, self-hostable) and a free model
# extracts the route from the results. Point the client at the search proxy and
# the proxy at your SearXNG instance (JSON format must be enabled on it). See
# DEPLOYMENT.md for a one-line Docker instance.
VITE_SEARCH_URL=/api/search
# SEARXNG_URL=https://your-searxng.example.com   (server env only, not committed)

# --- Admin gate ------------------------------------------------------------
# The admin area (usage analytics + the internal synthesis explorer) is gated by
# a client-side password. This keeps internal tooling out of casual view; it is
# NOT a security boundary (see SECURITY.md). Set this to the SHA-256 hex of your
# password to change it from the default ("apac-admin"). Generate with:
#   echo -n "yourpassword" | shasum -a 256
VITE_ADMIN_PASSWORD_HASH=
