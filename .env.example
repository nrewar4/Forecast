# Copy this file to .env and fill in your Supabase project values.
# Find them in your Supabase dashboard under Project Settings, then API.
# When these are set the app uses a shared cloud database.
# When they are empty the app falls back to browser storage automatically.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# OpenRouter powers the Product Research Assistant and the AI Product Search.
# Put your key (sk-or-v1-...) here in .env. A build-time VITE_ key is bundled into
# the browser app, so anyone who can load the app can read it. Use a limited key.
# "openrouter/auto" lets OpenRouter pick any available model automatically.
# Or pin one, e.g. google/gemini-2.0-flash-001, anthropic/claude-3.7-sonnet,
# meta-llama/llama-3.3-70b-instruct. If a pinned model is unavailable the app
# falls back automatically (ending at openrouter/auto).
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_MODEL=openrouter/auto

# Admin login. The app ships with username "admin" and password "apacss@2026".
# To change it, set a username and the sha256 hex hash of your password:
#   node -e "console.log(require('crypto').createHash('sha256').update('your-password').digest('hex'))"
VITE_ADMIN_USERNAME=
VITE_ADMIN_PASSWORD_SHA256=
