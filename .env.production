# Committed, non-secret build configuration for production (Vercel) builds.
# Vite loads this automatically during `vite build`. It only tells the client to
# call the server-side proxy at /api/ai; the actual OpenRouter key is NEVER here.
# Set the secret key as OPENROUTER_API_KEY in the Vercel project's Environment
# Variables (Project -> Settings -> Environment Variables). See DEPLOYMENT.md.
VITE_AI_PROXY_URL=/api/ai

# Optional web-grounding for the synthesis-route lookup without OpenRouter credit.
# The client always calls /api/search; that proxy returns empty results until you
# set SEARXNG_URL (a non-VITE secret) in Vercel to a SearXNG instance.
VITE_SEARCH_URL=/api/search
